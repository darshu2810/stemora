# STEMORA environment variables.
#
# Local development: copy to .env.local and fill in.
# Deployment: set all four in your host's environment settings (Vercel:
# Project -> Settings -> Environment Variables) BEFORE the first deploy.
#
# .env.local is gitignored. This file is committed and must never hold a
# real value.

# --- Supabase -----------------------------------------------------------
# Project Settings -> API. Both are publishable: they are guarded by Row
# Level Security and are meant to reach the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only, and powerful: it bypasses Row Level Security entirely. Used
# for exactly one thing -- the Supabase Auth admin API that emails student
# invitations. Never prefix it with NEXT_PUBLIC_, and never commit it.
# Project Settings -> API keys -> service_role.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ----------------------------------------------------------------
# Where invitation and password-reset links send people back to. Must be the
# real deployed origin in production, with no trailing slash -- if this is
# wrong, every invitation email points students at localhost.
#   local:      http://localhost:3000
#   production: https://your-domain.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
